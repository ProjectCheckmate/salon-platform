# Database
DATABASE_URL="postgresql://user:password@localhost:5432/salon_platform"

# NextAuth
AUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# Admin seeding (no password ever hardcoded in source)
ADMIN_EMAIL="akhilsingla304@gmail.com"
ADMIN_INITIAL_PASSWORD="" # leave blank to auto-generate on first seed

# AI (Ollama - local, no API key needed)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.1"

# Payments (provider abstraction - fill in when you pick a gateway)
PAYMENT_PROVIDER="mock" # mock | razorpay
RAZORPAY_KEY_ID=""
NEXT_PUBLIC_RAZORPAY_KEY_ID="" # SAME value as RAZORPAY_KEY_ID above, duplicated with the
                                 # NEXT_PUBLIC_ prefix so the Checkout widget can read it
                                 # client-side. This is the publishable key id, not a secret
                                 # — safe to expose. NEVER give RAZORPAY_KEY_SECRET this prefix.
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET="" # from Razorpay Dashboard > Webhooks, NOT the same as your API secret
# Point Razorpay's webhook URL (in their dashboard) at:
#   https://yourdomain.com/api/payments/webhook
# and select at least the "payment.captured" event.

# Maps / location
MAPS_PROVIDER="mock" # mock | google | mapbox
MAPS_API_KEY=""

# Notifications
NOTIFICATION_PROVIDER="mock" # mock | whatsapp
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_ID=""
EMAIL_PROVIDER="mock"
EMAIL_API_KEY=""
